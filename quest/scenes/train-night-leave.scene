# Bug hunt round 1 (trains): at midnight he rides between stations, gets off as it runs, and the train goes on
# without him (it neither stops dead nor loses cars), while he lands on his feet.
stream on
time 0.75
train at station
survival on
ride nearest train
tick 25
print train
expect train.speed > 2
hold sneak 0.1
tick 0.05
expect riding == 0
tick 5
print train
print player
expect train.speed > 2
expect train.cars >= 3
expect player.health >= 18
expect player.inblock == 0
