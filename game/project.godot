; Alabaster (working title): The Capital's war, a native Godot 4 game. Everything is code-driven and
; procedural; no editor is needed (see docs/status/capital-game.md).

config_version=5

[application]

config/name="Alabaster"
config/description="The Capital at war: a procedural open-world military game."
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="CapitalGame"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.92, 0.93, 0.94, 1)
boot_splash/show_image=false
run/max_fps=0

[audio]

driver/enable_input=false
buses/default_bus_layout=""

[autoload]

Settings="*res://scripts/core/settings.gd"
Controls="*res://scripts/core/controls.gd"
Sfx="*res://scripts/audio/sfx.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/integer_division=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/unused_parameter=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
3d/default_gravity=9.81

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/directional_shadow/16_bits=true
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels=1.5
environment/defaults/default_clear_color=Color(0.55, 0.66, 0.8, 1)
anti_aliasing/screen_space_roughness_limiter/enabled=true
global_illumination/sdfgi/probe_ray_count=1
global_illumination/sdfgi/frames_to_converge=2
global_illumination/sdfgi/frames_to_update_light=1
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=48
environment/ssao/quality=1
environment/ssao/half_size=true
environment/ssil/half_size=true
environment/screen_space_reflection/roughness_quality=1
textures/decals/filter=3
limits/global_shader_variables/buffer_size=65536

[xr]

openxr/enabled=false
shaders/enabled=false

[shader_globals]

weather_wetness={
"type": "float",
"value": 0.0
}
weather_snow={
"type": "float",
"value": 0.0
}
snow_line={
"type": "float",
"value": 1300.0
}
wind={
"type": "vec4",
"value": Vector4(1, 0, 0.4, 0)
}
horizon_fog={
"type": "vec4",
"value": Vector4(0.55, 0.62, 0.72, 0.00005)
}
night={
"type": "float",
"value": 0.0
}
terrain_heightmap={
"type": "sampler2D",
"value": ""
}
terrain_mask={
"type": "sampler2D",
"value": ""
}
terrain_detail={
"type": "sampler2D",
"value": ""
}
terrain_normal={
"type": "sampler2D",
"value": ""
}
